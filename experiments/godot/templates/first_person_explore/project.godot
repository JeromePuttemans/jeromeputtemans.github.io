; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gnomon"
config/description="A first-person exploration game on floating islands where you move the sun and walk on shadows."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

ConfigManager="*res://autoloads/ConfigManager.gd"
SaveManager="*res://autoloads/SaveManager.gd"
StringManager="*res://autoloads/StringManager.gd"
Sfx="*res://autoloads/Sfx.gd"
GameState="*res://autoloads/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.62, 0.78, 1)
